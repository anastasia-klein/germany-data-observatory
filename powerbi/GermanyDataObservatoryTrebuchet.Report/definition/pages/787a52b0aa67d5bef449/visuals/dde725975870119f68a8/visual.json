          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Why clusters? Grouping structurally similar districts makes comparisons more meaningful than one national average. The same groups are used for every election.",
                    "textStyle": {
                      "fontFamily": "Trebuchet MS",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Eleven of 14 indicators define the model: density, population change, migration balance, foreign-population share, ages 0–17 and 65+, workplace density, manufacturing, unemployment, disposable income and GDP per capita.",
                    "textStyle": {
                      "fontFamily": "Trebuchet MS",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Birth/death balance, services employment and minimum-security benefits remain in the report, but are excluded from clustering because they strongly overlap with retained inputs (|r| > 0.90).",
                    "textStyle": {
                      "fontFamily": "Trebuchet MS",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
