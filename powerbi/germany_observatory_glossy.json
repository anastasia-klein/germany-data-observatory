{
  "name": "Germany Data Observatory - Editorial Light",
  "dataColors": [
    "#7357E8",
    "#11B89A",
    "#FF6B57",
    "#F9C642",
    "#198FE3",
    "#202124",
    "#E2231A",
    "#2FB6E8"
  ],
  "background": "#FFFFFF",
  "foreground": "#20242A",
  "tableAccent": "#0878BE",
  "good": "#11B89A",
  "neutral": "#F9C642",
  "bad": "#E2231A",
  "maximum": "#202124",
  "center": "#F3F6F8",
  "minimum": "#DCE5EB",
  "null": "#98A2AB",
  "firstLevelElements": "#20242A",
  "secondLevelElements": "#68727D",
  "thirdLevelElements": "#E6EBEF",
  "fourthLevelElements": "#68727D",
  "secondaryBackground": "#F3F6F8",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#20242A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#68727D"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 18,
      "color": "#20242A"
    }
  },
  "visualStyles": {
    "pageNavigator": {
      "*": {
        "text": [
          {
            "$id": "default",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#68727D"
              }
            }
          },
          {
            "$id": "selected",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#075F96"
              }
            }
          }
        ],
        "shape": [
          {
            "$id": "default",
            "tileShape": "rectangle",
            "roundEdge": 6
          }
        ],
        "fill": [
          {
            "$id": "default",
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#F3F8FC"
              }
            }
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#E7F3FB"
              }
            }
          }
        ],
        "outline": [
          {
            "$id": "default",
            "transparency": 100
          },
          {
            "$id": "hover",
            "transparency": 100
          },
          {
            "$id": "press",
            "transparency": 100
          },
          {
            "$id": "selected",
            "transparency": 100
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 18,
            "textWrap": true,
            "fontColor": { "solid": { "color": "#20242A" } }
          }
        ],
        "label": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": { "solid": { "color": "#68727D" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6EBEF" } },
            "radius": 12,
            "width": 1
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": { "solid": { "color": "#20242A" } }
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "textSize": 9,
            "fontColor": { "solid": { "color": "#68727D" } }
          }
        ],
        "dropdown": [
          {
            "borderRadius": 10,
            "borderColor": { "solid": { "color": "#DCE5EB" } }
          }
        ],
        "spacing": [
          {
            "customizeSpacing": true,
            "spaceBelowTitle": 0,
            "spaceBelowTitleArea": 0,
            "spaceAbovePlotArea": 0
          }
        ],
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 8,
            "right": 8
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6EBEF" } },
            "radius": 12,
            "width": 1
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": { "solid": { "color": "#20242A" } },
            "wordWrap": true
          }
        ],
        "rowHeaders": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": { "solid": { "color": "#20242A" } }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": { "solid": { "color": "#20242A" } }
          }
        ],
        "total": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "fontColor": { "solid": { "color": "#20242A" } }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": false,
            "rowPadding": 3
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6EBEF" } },
            "radius": 12,
            "width": 1
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": { "solid": { "color": "#20242A" } }
          }
        ],
        "categoryAxis": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": { "solid": { "color": "#68727D" } }
          }
        ],
        "valueAxis": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": { "solid": { "color": "#68727D" } },
            "gridlineColor": { "solid": { "color": "#E6EBEF" } }
          }
        ],
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "color": { "solid": { "color": "#68727D" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6EBEF" } },
            "radius": 12,
            "width": 1
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": { "solid": { "color": "#20242A" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6EBEF" } },
            "radius": 12,
            "width": 1
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": { "solid": { "color": "#20242A" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6EBEF" } },
            "radius": 12,
            "width": 1
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": { "solid": { "color": "#20242A" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6EBEF" } },
            "radius": 12,
            "width": 1
          }
        ]
      }
    },
    "shapeMap": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": { "solid": { "color": "#20242A" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6EBEF" } },
            "radius": 12,
            "width": 1
          }
        ]
      }
    }
  }
}
