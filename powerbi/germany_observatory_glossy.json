{
  "name": "Germany Data Observatory - Editorial Light",
  "dataColors": [
    "#7357E8",
    "#11B89A",
    "#FF6B57",
    "#F9C642",
    "#198FE3",
    "#202124",
    "#E2231A",
    "#2FB6E8"
  ],
  "background": "#FFFFFF",
  "foreground": "#20242A",
  "tableAccent": "#0878BE",
  "good": "#11B89A",
  "neutral": "#F9C642",
  "bad": "#E2231A",
  "maximum": "#202124",
  "center": "#F3F6F8",
  "minimum": "#DCE5EB",
  "null": "#98A2AB",
  "firstLevelElements": "#20242A",
  "secondLevelElements": "#68727D",
  "thirdLevelElements": "#E6EBEF",
  "fourthLevelElements": "#68727D",
  "secondaryBackground": "#F3F6F8",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#20242A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#68727D"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#20242A"
    }
  },
  "visualStyles": {
    "pageNavigator": {
      "*": {
        "text": [
          {
            "$id": "default",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#68727D"
              }
            }
          },
          {
            "$id": "selected",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#075F96"
              }
            }
          }
        ],
        "shape": [
          {
            "$id": "default",
            "tileShape": "rectangle",
            "roundEdge": 6
          }
        ],
        "fill": [
          {
            "$id": "default",
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#F3F8FC"
              }
            }
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#E7F3FB"
              }
            }
          }
        ],
        "outline": [
          {
            "$id": "default",
            "transparency": 100
          },
          {
            "$id": "hover",
            "transparency": 100
          },
          {
            "$id": "press",
            "transparency": 100
          },
          {
            "$id": "selected",
            "transparency": 100
          }
        ]
      }
    }
  }
}
