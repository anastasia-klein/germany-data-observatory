                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#68727D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Change is measured in percentage points: 20% to 25% is +5 pp. Structural clusters stay fixed across elections, and each party’s map scale stays fixed across 2017–2025.",
