              {
                "textRuns": [
                  {
                    "value": "Germany averages weight districts equally: this is not the official vote-weighted national result. Changes are percentage points, not percentage growth.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "High support means at or above the party’s district median. Portrait labels give the share of all high-support districts, not the share within that cluster.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Explorer percentiles rank raw values. Its peers are nearest in PC1–PC4; the scatter shows PC1–PC2 only.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              }
            ]
