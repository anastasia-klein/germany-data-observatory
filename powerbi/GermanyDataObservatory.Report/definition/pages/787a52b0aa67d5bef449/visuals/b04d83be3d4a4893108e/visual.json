    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Stable regions contain 234 of 400 districts (58.5%). Counts alone can conceal concentration: compare cluster sizes as well as the number of high-support districts.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "From 2021 to 2025, AfD gained in all 400 districts, most strongly in the ageing periphery. SPD and FDP lost support in every district.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "In 2025, AfD has the highest cluster mean in the ageing periphery. CDU/CSU leads in stable regions and metropolitan hubs. Die Linke’s lowest cluster mean is in stable regions.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "CDU/CSU gained in 380 districts after 2021 but remained below its 2017 mean. SPD’s mean district share fell from 25.7% to 15.7%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Die Linke recovered without regaining its 2017 mean; its recovery was stronger in urban clusters. GRÜNE remained strongest in metropolitan hubs despite losing support there.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Mean district turnout rose from 75.8% in 2017 to 82.4% in 2025. It increased in all 400 districts, while gaps between structural clusters persisted.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#546575"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
